<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Resource Include="Assets\Flags\*.png" />
    <ProjectReference Include="..\..\..\src\AJ.VPN.Infrastructure\AJ.VPN.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\AJ.VPN.V2RayNAdapter\AJ.VPN.V2RayNAdapter.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Shaghad</AssemblyName>
    <RootNamespace>AJ.VPN.Desktop</RootNamespace>
    <Title>SHAGHAD</Title>
    <AssemblyTitle>SHAGHAD</AssemblyTitle>
    <Product>SHAGHAD</Product>
    <Description>Modern Secure Network Client</Description>
    <Version>0.4.0</Version>
    <ApplicationIcon>..\..\..\branding\icons\shaghad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\cores\**\*" Link="cores\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="..\..\..\branding\icons\shaghad.ico" Link="Assets/shaghad.ico" />
    <Resource Include="..\..\..\branding\fonts\*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
    <Resource Include="..\..\..\branding\fonts\OFL.txt" Link="Assets/Licenses/Vazirmatn-OFL.txt" />
    <Resource Include="..\..\..\LICENSE" Link="Assets/Licenses/GPL-3.0.txt" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
</Project>

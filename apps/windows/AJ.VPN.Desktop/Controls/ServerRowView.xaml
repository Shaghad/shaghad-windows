<UserControl x:Class="AJ.VPN.Desktop.Controls.ServerRowView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="LeftToRight">
 <Border Height="72" Margin="0,0,0,6" Padding="12,6" CornerRadius="10" Background="{DynamicResource SurfaceBrush}">
  <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger></Style.Triggers>
  </Style></Border.Style>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image Source="{Binding Flag}" Width="32" Height="24" ToolTip="{Binding CountryDisplay}" AutomationProperties.Name="{Binding CountryDisplay}"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock Text="{Binding Server.Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Server.Name}" FlowDirection="{DynamicResource ContentFlowDirection}"/>
    <DockPanel Margin="0,3,0,0"><TextBlock Text="{Binding ProtocolDisplay}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" FlowDirection="LeftToRight"/><TextBlock Text="{Binding SelectionDisplay}" FontSize="11" Foreground="{DynamicResource SymbolBrush}" Margin="10,0,0,0"/></DockPanel>
   </StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding LastTestedDisplay}">
    <Border CornerRadius="8" Background="{DynamicResource StatusSurfaceBrush}" Padding="8,2" HorizontalAlignment="Left"><TextBlock Text="{Binding PingDisplay}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" FontSize="12" FlowDirection="LeftToRight" ToolTip="{Binding TestExplanation}"/></Border>
    <DockPanel Margin="2,3,0,0"><Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/><TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{Binding StatusBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel>
   </StackPanel>
   <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="{Binding FavoriteDisplay}" Command="{Binding FavoriteCommand}" ToolTip="{DynamicResource FavoriteAction}" Foreground="{DynamicResource WarningBrush}" Padding="6" Margin="0,0,4,0" Width="32" AutomationProperties.Name="{DynamicResource FavoriteAction}"/>
    <Button Content="{DynamicResource Connect}" Command="{Binding ConnectCommand}" Style="{StaticResource ShaghadPrimaryButton}" Padding="10,5" Margin="0,0,4,0"/>
    <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Padding="7" Margin="0" Click="OpenMenu" ToolTip="{DynamicResource MoreActions}" AutomationProperties.Name="{DynamicResource MoreActions}">
     <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
      <MenuItem Header="{DynamicResource SelectServer}" Command="{Binding SelectCommand}"/><MenuItem Header="{DynamicResource TestServer}" Command="{Binding TestCommand}"/><MenuItem Header="{DynamicResource FavoriteAction}" Command="{Binding FavoriteCommand}"/><MenuItem Header="{DynamicResource SetCountry}" Command="{Binding CountryCommand}"/><Separator/><MenuItem Header="{DynamicResource Remove}" Command="{Binding RemoveCommand}"/>
     </ContextMenu></Button.ContextMenu>
    </Button>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>

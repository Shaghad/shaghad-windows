<Window x:Class="AJ.VPN.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AJ.VPN.Desktop" xmlns:controls="clr-namespace:AJ.VPN.Desktop.Controls"
 Title="SHAGHAD" Icon="Assets/shaghad.ico" Width="1100" Height="700" MinWidth="960" MinHeight="540"
 FlowDirection="LeftToRight" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
 FontFamily="{DynamicResource UiFont}" FontSize="14" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <local:NavigationMatchConverter x:Key="NavigationMatch"/>
  <Style x:Key="Page" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/></Style>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  <DataTemplate x:Key="ServersPageTemplate">
   <Grid FlowDirection="LeftToRight">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding TotalServersDisplay}" Margin="24,0,0,0" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/><TextBlock Text="{DynamicResource Servers}" Style="{StaticResource Heading}" Margin="0"/></DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Margin="0,2,12,2"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="12,6" ToolTip="{DynamicResource SearchLabel}" AutomationProperties.Name="{DynamicResource SearchLabel}"/><TextBlock Text="{DynamicResource SearchLabel}" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{DynamicResource ImportServer}" Click="OpenImport" IsEnabled="{Binding CanEdit}" Style="{StaticResource ShaghadPrimaryButton}"/><Button Content="{DynamicResource ClipboardImport}" Click="OpenClipboardImport" IsEnabled="{Binding CanEdit}"/><Button Content="{DynamicResource TestAllLabel}" Command="{Binding TestAllCommand}" IsEnabled="{Binding CanTest}"/>
      <Button Content="{DynamicResource SortLabel}" Click="OpenToolbarMenu" Margin="0,2,0,2"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
       <MenuItem Header="{DynamicResource LowestLatencySort}" Command="{Binding SortServersCommand}" CommandParameter="LowestLatency"/><MenuItem Header="{DynamicResource HighestLatencySort}" Command="{Binding SortServersCommand}" CommandParameter="HighestLatency"/><MenuItem Header="{DynamicResource NameLabel}" Command="{Binding SortServersCommand}" CommandParameter="Name"/><MenuItem Header="{DynamicResource CountryLabel}" Command="{Binding SortServersCommand}" CommandParameter="Country"/><MenuItem Header="{DynamicResource ProtocolLabel}" Command="{Binding SortServersCommand}" CommandParameter="Protocol"/><MenuItem Header="{DynamicResource LastTestedLabel}" Command="{Binding SortServersCommand}" CommandParameter="LastTested"/>
      </ContextMenu></Button.ContextMenu></Button>
     </StackPanel>
    </Grid>
    <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><DockPanel><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SymbolBrush}" Margin="0,0,10,0" FontSize="22"/><TextBlock Text="{DynamicResource AutoTitle}" FontSize="18" FontWeight="SemiBold" Style="{StaticResource LocalizedText}"/></DockPanel>
       <TextBlock Text="{DynamicResource AutoHint}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3"/>
       <DockPanel><TextBlock Text="{Binding AutoServerDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding AutoServerDisplay}"/><TextBlock Text="{Binding AutoLatencyDisplay}" Margin="12,0,0,0" Foreground="{DynamicResource SymbolBrush}" FlowDirection="LeftToRight"/></DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><Button Content="{DynamicResource EnableAuto}" Command="{Binding AutoCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource ShaghadPrimaryButton}"/><Button Content="{DynamicResource RetestLabel}" Command="{Binding TestAllCommand}" IsEnabled="{Binding CanTest}"/><Button Content="{DynamicResource ManualMode}" Command="{Binding ManualCommand}" IsEnabled="{Binding CanEdit}" Margin="0" Visibility="{Binding IsAuto, Converter={StaticResource BooleanVisibility}}"/></StackPanel>
     </Grid>
    </Border>
    <WrapPanel Grid.Row="3" Margin="0,0,0,8"><Button Content="{DynamicResource AllServersFilter}" Command="{Binding FilterServersCommand}" CommandParameter="All"/><Button Content="{DynamicResource FavoritesFilter}" Command="{Binding FilterServersCommand}" CommandParameter="Favorites"/><Button Content="{DynamicResource HealthyFilter}" Command="{Binding FilterServersCommand}" CommandParameter="Healthy"/><Button Content="{DynamicResource FailedFilter}" Command="{Binding FilterServersCommand}" CommandParameter="Failed"/><Button Content="{DynamicResource UntestedFilter}" Command="{Binding FilterServersCommand}" CommandParameter="Untested"/><CheckBox Content="{DynamicResource FavoritesFirst}" Foreground="{DynamicResource TextBrush}" IsChecked="{Binding FavoritesFirst}" VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
    <DockPanel Grid.Row="4" Margin="0,0,0,8" Visibility="{Binding HasTestProgress, Converter={StaticResource BooleanVisibility}}"><Button DockPanel.Dock="Right" Content="{DynamicResource CancelLabel}" Command="{Binding CancelTestsCommand}" Visibility="{Binding Testing, Converter={StaticResource BooleanVisibility}}"/><StackPanel><TextBlock Text="{Binding TestProgressText}" Style="{StaticResource SecondaryText}"/><ProgressBar Height="3" IsIndeterminate="True" Margin="0,4,12,0" Visibility="{Binding Testing, Converter={StaticResource BooleanVisibility}}"/></StackPanel></DockPanel>
    <Grid Grid.Row="5">
     <ListBox x:Name="VirtualServerList" ItemsSource="{Binding ServerView}" SelectedItem="{Binding SelectedServerRow}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1">
      <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ShaghadPageScrollBar}"/></ListBox.Resources>
      <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="Stretch"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><controls:ServerRowView/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ServerView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource SymbolBrush}" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource NoMatchingServers}" Style="{StaticResource SecondaryText}" Margin="0,10"/></StackPanel>
    </Grid>
   </Grid>
  </DataTemplate>
  <Style x:Key="DashboardPrimaryAction" TargetType="Button" BasedOn="{StaticResource ShaghadPrimaryButton}">
   <Setter Property="Content" Value="{DynamicResource Connect}"/><Setter Property="Command" Value="{Binding ConnectCommand}"/><Setter Property="IsEnabled" Value="{Binding CanEdit}"/>
   <Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="0,0,0,8"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HasActiveProfile}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Content" Value="{DynamicResource Disconnect}"/><Setter Property="Command" Value="{Binding DisconnectCommand}"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Content" Value="{DynamicResource Disconnect}"/><Setter Property="Command" Value="{Binding DisconnectCommand}"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Disconnecting"><Setter Property="Content" Value="{DynamicResource Disconnecting}"/><Setter Property="IsEnabled" Value="False"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="DashboardHeroCard" TargetType="Border" BasedOn="{StaticResource ShaghadCard}"><Setter Property="Height" Value="176"/><Style.Triggers><DataTrigger Binding="{Binding HasActiveProfile}" Value="True"><Setter Property="Height" Value="156"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="DashboardHint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
   <Setter Property="Text" Value="{DynamicResource DashboardSetupHint}"/><Setter Property="FontSize" Value="13"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HasActiveProfile}" Value="True"><Setter Property="Text" Value="{DynamicResource DashboardReadyHint}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Text" Value="{DynamicResource DashboardStartingHint}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Text" Value="{DynamicResource DashboardConnectedHint}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Disconnecting"><Setter Property="Text" Value="{DynamicResource Disconnecting}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Text" Value="{DynamicResource DashboardErrorHint}"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid x:Name="ApplicationShell" FlowDirection="LeftToRight" Background="{DynamicResource PageBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="0" x:Name="SidebarColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Grid.ColumnSpan="2" Panel.ZIndex="20" Width="240" HorizontalAlignment="Left" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" Padding="{DynamicResource SidebarPadding}" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource SidebarHeaderMargin}">
     <DockPanel FlowDirection="LeftToRight"><Image Source="{DynamicResource ShaghadSymbol}" Width="44" Height="44" Margin="0,0,10,0" AutomationProperties.Name="SHAGHAD symbol"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="SHAGHAD" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="شغاد" FontFamily="{DynamicResource PersianFont}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/></StackPanel>
     </DockPanel>
     <Button x:Name="DrawerCloseButton" Content="×" Click="ToggleSidebar" HorizontalAlignment="Left" ToolTip="Close navigation"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource About}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE946;" CommandParameter="About" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=About}" AutomationProperties.AutomationId="NavAbout"/>
     <Button x:Name="SidebarExitButton" ToolTip="{DynamicResource Exit}" Content="{DynamicResource Exit}" Command="{Binding ExitCommand}" AutomationProperties.AutomationId="ExitButton" Margin="0,8,0,0"/>
     
    </StackPanel>
    <StackPanel>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Dashboard}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE80F;" CommandParameter="Dashboard" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Dashboard}" AutomationProperties.AutomationId="NavDashboard"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Servers}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE968;" CommandParameter="Servers" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Servers}" AutomationProperties.AutomationId="NavServers"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Subscriptions}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE8D4;" CommandParameter="Subscriptions" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Subscriptions}" AutomationProperties.AutomationId="NavSubscriptions"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Routing}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE8AB;" CommandParameter="Routing" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Routing}"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Statistics}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE9D9;" CommandParameter="Statistics" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Statistics}"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Diagnostics}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE90F;" CommandParameter="Diagnostics" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Diagnostics}" AutomationProperties.AutomationId="NavDiagnostics"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Settings}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE713;" CommandParameter="Settings" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Settings}" AutomationProperties.AutomationId="NavSettings"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <DockPanel x:Name="ContentHost" Grid.Column="1" FlowDirection="LeftToRight" Margin="{DynamicResource ContentMargin}">
   <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" FlowDirection="LeftToRight">
    <Button x:Name="HamburgerButton" Content="☰" Click="ToggleSidebar" DockPanel.Dock="Left" AutomationProperties.Name="Navigation menu" AutomationProperties.AutomationId="HamburgerButton" Width="44" Height="36"/>
    <TextBlock Text="SHAGHAD" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" Margin="12,0"/>
   </DockPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding Notice}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0">
    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LocalizedText}"><Style.Triggers><DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <Grid><ScrollViewer x:Name="PageScrollViewer" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0" CanContentScroll="False">
    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Servers"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ShaghadPageScrollBar}"/></ScrollViewer.Resources>
    <Grid MaxWidth="1160" HorizontalAlignment="Stretch">
     <StackPanel x:Name="DashboardPage">
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <Grid FlowDirection="LeftToRight">
       <Grid.ColumnDefinitions><ColumnDefinition Width="42*"/><ColumnDefinition Width="58*"/></Grid.ColumnDefinitions>
       <Border x:Name="ConnectionCard" Background="{DynamicResource SurfaceBrush}" CornerRadius="20" Padding="20" Margin="0,0,20,0">
        <StackPanel VerticalAlignment="Center">
         <Image Source="{DynamicResource ShaghadSymbol}" Width="58" Height="58" Margin="0,4,0,12"/>
         <TextBlock Text="شغاد" FontFamily="{DynamicResource PersianFont}" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,18"/>
         <Button x:Name="DashboardAction" Style="{StaticResource DashboardPrimaryAction}" Width="174" Height="174" HorizontalAlignment="Center" AutomationProperties.AutomationId="ConnectButton" AutomationProperties.Name="{Binding ConsumerStatus}">
          <Button.Template><ControlTemplate TargetType="Button">
           <Grid><Ellipse x:Name="PowerRing" Fill="{DynamicResource PageBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3"/>
            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="58" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Grid>
           <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerRing" Property="StrokeThickness" Value="5"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerRing" Property="Stroke" Value="{DynamicResource TextBrush}"/><Setter TargetName="PowerRing" Property="StrokeThickness" Value="5"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
            <DataTrigger Binding="{Binding State}" Value="Connected"><Setter TargetName="PowerRing" Property="Stroke" Value="{DynamicResource WarningBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding InternetVerified}" Value="True"><Setter TargetName="PowerRing" Property="Stroke" Value="{DynamicResource ConnectedBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error"><Setter TargetName="PowerRing" Property="Stroke" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
           </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
         </Button>
         <TextBlock Text="{Binding ConsumerStatus}" Style="{StaticResource LocalizedText}" TextAlignment="Center" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,4"/>
         <TextBlock Text="{Binding Verification}" Style="{StaticResource SecondaryText}" TextAlignment="Center" FontSize="12"/>
         <ProgressBar Height="3" IsIndeterminate="True" Margin="24,8" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
         <Button Content="{DynamicResource ImportServer}" Click="OpenImport" Visibility="{Binding NeedsServer, Converter={StaticResource BooleanVisibility}}" Margin="0,10,0,0"/>
        </StackPanel>
       </Border>
       <StackPanel Grid.Column="1">
        <TextBlock Text="{DynamicResource ConnectionStatus}" Style="{StaticResource SecondaryText}" FontSize="12"/>
        <DockPanel Height="30" Margin="0,6,0,14"><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding ConsumerStatus}" Style="{StaticResource LocalizedText}" FontSize="20" FontWeight="SemiBold"/></DockPanel>
        <Border x:Name="SelectedServerCard" Height="82" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
         <DockPanel><Image Source="{Binding ActiveFlag}" Width="30" Height="22" Margin="0,0,12,0"/>
          <StackPanel><TextBlock Text="{Binding ActiveServer}" Style="{StaticResource LocalizedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Location}" Style="{StaticResource SecondaryText}" FontSize="12"/>
           <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Protocol}"/><TextBlock Text=" · " /><TextBlock Text="{Binding CoreDisplay}"/><TextBlock x:Name="LatencyValue" Text="{Binding Latency}" Style="{StaticResource TechnicalText}" Margin="12,0,0,0"/></StackPanel>
          </StackPanel></DockPanel>
        </Border>
        <Border x:Name="ConnectionDetails" Height="100" Padding="0,12,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="{DynamicResource ExitIpLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding PublicIp}" FontSize="22" FlowDirection="LeftToRight" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectionMode}" Style="{StaticResource SecondaryText}" FontSize="12"/></StackPanel>
          <Button Grid.Column="1" Content="{DynamicResource CopyIp}" Command="{Binding CopyIpCommand}" IsEnabled="{Binding HasPublicIp}" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        <UniformGrid Columns="3" Margin="0,12,0,12">
         <StackPanel><TextBlock Text="{DynamicResource DownloadLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding DownloadSpeed}" FontSize="16" FlowDirection="LeftToRight"/><TextBlock Text="{Binding TotalDownloaded}" Style="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
         <StackPanel><TextBlock Text="{DynamicResource UploadLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding UploadSpeed}" FontSize="16" FlowDirection="LeftToRight"/><TextBlock Text="{Binding TotalUploaded}" Style="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
         <StackPanel><TextBlock Text="{DynamicResource DurationLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding Duration}" FontSize="16" FlowDirection="LeftToRight"/><TextBlock Text="{Binding Quality}" Style="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
        </UniformGrid>
        <TextBlock Text="{DynamicResource ProxyTrafficScope}" Style="{StaticResource SecondaryText}" FontSize="11"/>
        <TextBlock Text="{DynamicResource FastestServersLabel}" Style="{StaticResource LocalizedText}" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <ItemsControl ItemsSource="{Binding FastestServers}"><ItemsControl.ItemTemplate><DataTemplate>
         <Button Command="{Binding ConnectCommand}" ToolTip="{Binding LastTestedDisplay}" HorizontalContentAlignment="Stretch" Padding="4" Margin="0,2">
          <DockPanel><Image Source="{Binding Flag}" Width="24" Height="16" Margin="0,0,8,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding PingDisplay}"/><TextBlock Text="{Binding Server.Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{Binding StatusBrush}" Margin="8,0"/></DockPanel>
         </Button>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel Margin="0,10,0,0"><Button Content="{DynamicResource ChangeServer}" Command="{Binding NavigateCommand}" CommandParameter="Servers"/><Button Content="{DynamicResource TestProxy}" Command="{Binding ProbeCommand}" IsEnabled="{Binding CanProbe}"/></WrapPanel>
       </StackPanel>
      </Grid>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Subscriptions"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Subscriptions}" Style="{StaticResource Heading}" Margin="0,0,0,24"/>
      <WrapPanel Margin="0,0,0,16" IsEnabled="{Binding CanEdit}"><Button Content="{DynamicResource AddSubscription}" Click="OpenSubscription" Style="{StaticResource ShaghadPrimaryButton}"/><Button Content="{DynamicResource UpdateAllLabel}" Command="{Binding UpdateAllCommand}"/></WrapPanel>
      <TextBlock Text="{DynamicResource EmptySubscriptionManager}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" Visibility="{Binding NeedsSubscription, Converter={StaticResource BooleanVisibility}}"/><TextBlock Text="{DynamicResource SubscriptionManagerHint}" Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
      <ListBox ItemsSource="{Binding SubscriptionRows}" SelectedItem="{Binding SelectedSubscriptionRow}" ItemContainerStyle="{StaticResource SubscriptionManagerRow}" Height="280" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding Name}" Style="{StaticResource LocalizedText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource LocalizedText}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6"/><TextBlock Text="{Binding UpdateDisplay}" Style="{StaticResource LocalizedText}" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding CanEdit}"><Button Content="{DynamicResource EditLabel}" Click="EditSubscription"/><Button Content="{DynamicResource UpdateSubscription}" Command="{Binding UpdateSubscriptionCommand}"/><Button Content="{DynamicResource Remove}" Command="{Binding RemoveSubscriptionCommand}"/></WrapPanel>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Routing"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Routing}" Style="{StaticResource Heading}" Margin="0,0,0,24"/><Border Style="{StaticResource ShaghadCard}"><TextBlock Text="{DynamicResource RoutingUnavailable}" Style="{StaticResource SecondaryText}"/></Border>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Statistics"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Statistics}" Style="{StaticResource Heading}" Margin="0,0,0,24"/><Border Style="{StaticResource ShaghadCard}"><StackPanel><TextBlock Text="{DynamicResource ProxyTrafficScope}" Style="{StaticResource SecondaryText}"/><TextBlock Text="{Binding DownloadSpeed}" FontSize="28"/><TextBlock Text="{Binding UploadSpeed}" FontSize="28"/><TextBlock Text="{Binding TotalDownloaded}"/><TextBlock Text="{Binding TotalUploaded}"/></StackPanel></Border>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Diagnostics"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Diagnostics}" Style="{StaticResource Heading}" Margin="0,0,0,24"/>
      <Button Content="{DynamicResource RunChecks}" Command="{Binding DiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,0,0,20" Style="{StaticResource ShaghadPrimaryButton}" AutomationProperties.AutomationId="RunDiagnostics"/>
      <Button Content="{DynamicResource TestProxy}" Command="{Binding ProbeCommand}" IsEnabled="{Binding CanProbe}" HorizontalAlignment="Left" Margin="0,0,0,20" AutomationProperties.AutomationId="DiagnosticsProbe"/>
      <ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ShaghadCard}"><StackPanel>
       <TextBlock Text="{Binding Status}" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding Explanation}"/><TextBlock Text="{Binding PossibleCause}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/><TextBlock Text="{Binding RecommendedAction}" Margin="0,8,0,0"/>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Heading}" Margin="0,0,0,24"/>
      <Border Style="{StaticResource ShaghadCard}"><StackPanel>
       <CheckBox Content="{DynamicResource AutoFailoverLabel}" IsChecked="{Binding AutomaticFailover}"/>
       <CheckBox Content="{DynamicResource AutoRecoveryLabel}" IsChecked="{Binding AutomaticRecovery}"/>
       <TextBlock Text="{DynamicResource RecoveryPolicyHint}" Style="{StaticResource SecondaryText}" Margin="0,6,0,12"/>

<Window x:Class="AJ.VPN.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AJ.VPN.Desktop"
 Title="SHAGHAD" Icon="Assets/shaghad.ico" Width="1200" Height="760" MinWidth="960" MinHeight="540"
 FlowDirection="LeftToRight" WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
 FontFamily="{DynamicResource UiFont}" FontSize="14" WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <local:NavigationMatchConverter x:Key="NavigationMatch"/>
  <Style x:Key="Page" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/></Style>
  <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
  <Style x:Key="DashboardPrimaryAction" TargetType="Button" BasedOn="{StaticResource ShaghadPrimaryButton}">
   <Setter Property="Content" Value="{DynamicResource Connect}"/><Setter Property="Command" Value="{Binding ConnectCommand}"/><Setter Property="IsEnabled" Value="{Binding CanEdit}"/>
   <Setter Property="MinHeight" Value="48"/><Setter Property="Margin" Value="0,0,0,8"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HasActiveProfile}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Content" Value="{DynamicResource Disconnect}"/><Setter Property="Command" Value="{Binding DisconnectCommand}"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Content" Value="{DynamicResource Disconnect}"/><Setter Property="Command" Value="{Binding DisconnectCommand}"/><Setter Property="IsEnabled" Value="True"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Disconnecting"><Setter Property="Content" Value="{DynamicResource Disconnecting}"/><Setter Property="IsEnabled" Value="False"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="DashboardHeroCard" TargetType="Border" BasedOn="{StaticResource ShaghadCard}"><Setter Property="Height" Value="176"/><Style.Triggers><DataTrigger Binding="{Binding HasActiveProfile}" Value="True"><Setter Property="Height" Value="156"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="DashboardHint" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
   <Setter Property="Text" Value="{DynamicResource DashboardSetupHint}"/><Setter Property="FontSize" Value="13"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding HasActiveProfile}" Value="True"><Setter Property="Text" Value="{DynamicResource DashboardReadyHint}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Text" Value="{DynamicResource DashboardStartingHint}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Text" Value="{DynamicResource DashboardConnectedHint}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Disconnecting"><Setter Property="Text" Value="{DynamicResource Disconnecting}"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Text" Value="{DynamicResource DashboardErrorHint}"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid x:Name="ApplicationShell" FlowDirection="LeftToRight" Background="{DynamicResource PageBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="184" x:Name="SidebarColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Padding="{DynamicResource SidebarPadding}" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource SidebarHeaderMargin}">
     <DockPanel FlowDirection="LeftToRight"><Image Source="{DynamicResource ShaghadSymbol}" Width="44" Height="44" Margin="0,0,10,0" AutomationProperties.Name="SHAGHAD symbol"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="SHAGHAD" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="شغاد" FontFamily="{DynamicResource PersianFont}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/></StackPanel>
     </DockPanel>
     <Button Content="☰" Click="ToggleSidebar" HorizontalAlignment="Left" ToolTip="Compact navigation"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource About}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE946;" CommandParameter="About" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=About}" AutomationProperties.AutomationId="NavAbout"/>
     <Button x:Name="SidebarExitButton" ToolTip="{DynamicResource Exit}" Content="{DynamicResource Exit}" Command="{Binding ExitCommand}" AutomationProperties.AutomationId="ExitButton" Margin="0,8,0,0"/>
     
    </StackPanel>
    <StackPanel>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Dashboard}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE80F;" CommandParameter="Dashboard" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Dashboard}" AutomationProperties.AutomationId="NavDashboard"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Servers}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE968;" CommandParameter="Servers" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Servers}" AutomationProperties.AutomationId="NavServers"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Subscriptions}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE8D4;" CommandParameter="Subscriptions" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Subscriptions}" AutomationProperties.AutomationId="NavSubscriptions"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Routing}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE8AB;" CommandParameter="Routing" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Routing}"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Statistics}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE9D9;" CommandParameter="Statistics" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Statistics}"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Diagnostics}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE90F;" CommandParameter="Diagnostics" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Diagnostics}" AutomationProperties.AutomationId="NavDiagnostics"/>
     <RadioButton Style="{StaticResource ShaghadNavigationItem}" Content="{DynamicResource Settings}" GroupName="Navigation" Command="{Binding NavigateCommand}" Tag="&#xE713;" CommandParameter="Settings" IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource NavigationMatch}, ConverterParameter=Settings}" AutomationProperties.AutomationId="NavSettings"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <DockPanel x:Name="ContentHost" Grid.Column="1" FlowDirection="LeftToRight" Margin="{DynamicResource ContentMargin}">
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding Notice}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Notice}" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0">
    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource LocalizedText}"><Style.Triggers><DataTrigger Binding="{Binding Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <ScrollViewer x:Name="PageScrollViewer" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0" CanContentScroll="False">
    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ShaghadPageScrollBar}"/></ScrollViewer.Resources>
    <Grid MaxWidth="1160" HorizontalAlignment="Stretch">
     <StackPanel x:Name="DashboardPage">
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Dashboard}" Style="{StaticResource Heading}"/>
      <Border x:Name="ConnectionCard" Style="{StaticResource DashboardHeroCard}" Padding="20,8">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
                  <DockPanel><Ellipse Width="7" Height="7" Margin="0,0,8,0" DockPanel.Dock="Left"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Connecting"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding InternetVerified}" Value="True"><Setter Property="Fill" Value="{DynamicResource ConnectedBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{DynamicResource ConnectionStatus}" Style="{StaticResource SecondaryText}"/></DockPanel>
         <TextBlock Text="{Binding ConsumerStatus}" Style="{StaticResource LocalizedText}" FontSize="28" LineHeight="36" FontWeight="SemiBold" Margin="0,4,0,6"/>
         <TextBlock Text="{Binding Verification}" Style="{StaticResource SecondaryText}" FontSize="12"/>
         <ProgressBar Height="3" Margin="0,12,24,0" IsIndeterminate="True" Visibility="{Binding Busy, Converter={StaticResource BooleanVisibility}}"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
         <Button x:Name="DashboardAction" Style="{StaticResource DashboardPrimaryAction}" Height="68" FontSize="22" FontWeight="SemiBold" AutomationProperties.AutomationId="ConnectButton"/>
         <Button Content="{DynamicResource ImportServer}" Click="OpenImport" Visibility="{Binding NeedsServer, Converter={StaticResource BooleanVisibility}}"/>
         <Button Content="{DynamicResource TestProxy}" Command="{Binding ProbeCommand}" IsEnabled="{Binding CanProbe}" FontSize="12"/>
        </StackPanel>
       </Grid>
      </Border>
      <Border x:Name="SelectedServerCard" Height="96" Style="{StaticResource ShaghadServerCard}" Padding="18,8">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,20,0"><TextBlock Text="{DynamicResource SelectedServer}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding ActiveServer}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveServer}" Style="{StaticResource LocalizedText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Location}" Style="{StaticResource SecondaryText}" FontSize="12"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock Text="{Binding Protocol}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Latency}" Style="{StaticResource SecondaryText}" FontSize="11"/><TextBlock x:Name="LatencyValue" Text="{Binding Latency}" Style="{StaticResource TechnicalText}" Margin="0,4"/></StackPanel>
        <Button Grid.Column="2" Content="{DynamicResource ChangeServer}" Command="{Binding NavigateCommand}" CommandParameter="Servers" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <Border x:Name="ConnectionDetails" Height="100" Style="{StaticResource ShaghadCard}" Padding="18,8">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource ExitIpLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding PublicIp}" FontSize="22" FontWeight="SemiBold" FlowDirection="LeftToRight"/><TextBlock Text="{Binding ConnectionMode}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource CopyIp}" Command="{Binding CopyIpCommand}" IsEnabled="{Binding HasPublicIp}" VerticalAlignment="Center"/>
       </Grid>
      </Border>
      <UniformGrid Columns="3" Margin="0,0,0,6">
       <StackPanel><TextBlock Text="{DynamicResource DownloadLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="—" FontSize="22"/><TextBlock Text="{DynamicResource UnavailableMetric}" Style="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
       <StackPanel><TextBlock Text="{DynamicResource UploadLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="—" FontSize="22"/><TextBlock Text="{DynamicResource UnavailableMetric}" Style="{StaticResource SecondaryText}" FontSize="11"/></StackPanel>
       <StackPanel><TextBlock Text="{DynamicResource DurationLabel}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock Text="{Binding Duration}" FontSize="22" FlowDirection="LeftToRight"/></StackPanel>
      </UniformGrid>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Servers"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Servers}" Style="{StaticResource Heading}" Margin="0,0,0,24"/>
      <WrapPanel Margin="0,0,0,14" IsEnabled="{Binding CanEdit}">
       <Button Content="{DynamicResource ImportServer}" Click="OpenImport" Style="{StaticResource ShaghadPrimaryButton}"/>
       <Button Content="{DynamicResource ClipboardImport}" Command="{Binding ClipboardCommand}"/>
       <Button Content="{DynamicResource TestAllLabel}" Command="{Binding TestAllCommand}"/>
       <TextBlock Text="{DynamicResource SearchLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="8,0"/><TextBox Width="160" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search servers" AutomationProperties.Name="Search servers"/>
      </WrapPanel>
      <TextBlock Text="{DynamicResource EmptyServerManager}" Style="{StaticResource SecondaryText}" Margin="0,0,0,14" Visibility="{Binding NeedsServer, Converter={StaticResource BooleanVisibility}}"/>
      <ListView ItemsSource="{Binding ServerView}" SelectedItem="{Binding SelectedServerRow}" Height="280" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
       <ListView.Resources><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{DynamicResource SidebarBrush}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Padding" Value="10"/></Style></ListView.Resources>
       <ListView.View><GridView>
        <GridViewColumn Header="{DynamicResource NameLabel}" Width="190" DisplayMemberBinding="{Binding Server.Name}"/>
        <GridViewColumn Header="{DynamicResource CountryLabel}" Width="90" DisplayMemberBinding="{Binding CountryDisplay}"/>
        <GridViewColumn Header="{DynamicResource ProtocolLabel}" Width="90" DisplayMemberBinding="{Binding Server.Protocol}"/>
        <GridViewColumn Header="{DynamicResource PingLabel}" Width="80" DisplayMemberBinding="{Binding PingDisplay}"/>
        <GridViewColumn Header="{DynamicResource StatusLabel}" Width="90" DisplayMemberBinding="{Binding StatusDisplay}"/><GridViewColumn Header="{DynamicResource SelectionLabel}" Width="90" DisplayMemberBinding="{Binding SelectionDisplay}"/>
       </GridView></ListView.View>
      </ListView>
      <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding CanEdit}"><Button Content="{DynamicResource SelectServer}" Command="{Binding ActivateCommand}"/><Button Content="{DynamicResource Connect}" Command="{Binding ConnectSelectedCommand}"/><Button Content="{DynamicResource Remove}" Command="{Binding RemoveServerCommand}"/><Button Content="{DynamicResource SortNameLabel}" Command="{Binding SortServersCommand}" CommandParameter="Server.Name"/><Button Content="{DynamicResource SortProtocolLabel}" Command="{Binding SortServersCommand}" CommandParameter="Server.Protocol"/></WrapPanel>
      <TextBlock Text="{Binding ProfileResult}" Style="{StaticResource SecondaryText}" Margin="0,8"/>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Subscriptions"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Subscriptions}" Style="{StaticResource Heading}" Margin="0,0,0,24"/>
      <WrapPanel Margin="0,0,0,16" IsEnabled="{Binding CanEdit}"><Button Content="{DynamicResource AddSubscription}" Click="OpenSubscription" Style="{StaticResource ShaghadPrimaryButton}"/><Button Content="{DynamicResource UpdateAllLabel}" Command="{Binding UpdateAllCommand}"/></WrapPanel>
      <TextBlock Text="{DynamicResource EmptySubscriptionManager}" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" Visibility="{Binding NeedsSubscription, Converter={StaticResource BooleanVisibility}}"/><TextBlock Text="{DynamicResource SubscriptionManagerHint}" Style="{StaticResource SecondaryText}" Margin="0,0,0,16"/>
      <ListBox ItemsSource="{Binding SubscriptionRows}" SelectedItem="{Binding SelectedSubscriptionRow}" ItemContainerStyle="{StaticResource SubscriptionManagerRow}" Height="280" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}">
       <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding Name}" Style="{StaticResource LocalizedText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Style="{StaticResource LocalizedText}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6"/><TextBlock Text="{Binding UpdateDisplay}" Style="{StaticResource LocalizedText}" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Margin="0,14,0,0" IsEnabled="{Binding CanEdit}"><Button Content="{DynamicResource EditLabel}" Click="EditSubscription"/><Button Content="{DynamicResource UpdateSubscription}" Command="{Binding UpdateSubscriptionCommand}"/><Button Content="{DynamicResource Remove}" Command="{Binding RemoveSubscriptionCommand}"/></WrapPanel>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Routing"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Routing}" Style="{StaticResource Heading}" Margin="0,0,0,24"/><Border Style="{StaticResource ShaghadCard}"><TextBlock Text="{DynamicResource RoutingUnavailable}" Style="{StaticResource SecondaryText}"/></Border>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Statistics"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Statistics}" Style="{StaticResource Heading}" Margin="0,0,0,24"/><Border Style="{StaticResource ShaghadCard}"><TextBlock Text="{DynamicResource NoMetrics}" Style="{StaticResource SecondaryText}"/></Border>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Diagnostics"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Diagnostics}" Style="{StaticResource Heading}" Margin="0,0,0,24"/>
      <Button Content="{DynamicResource RunChecks}" Command="{Binding DiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,0,0,20" Style="{StaticResource ShaghadPrimaryButton}" AutomationProperties.AutomationId="RunDiagnostics"/>
      <Button Content="{DynamicResource TestProxy}" Command="{Binding ProbeCommand}" IsEnabled="{Binding CanProbe}" HorizontalAlignment="Left" Margin="0,0,0,20" AutomationProperties.AutomationId="DiagnosticsProbe"/>
      <ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource ShaghadCard}"><StackPanel>
       <TextBlock Text="{Binding Status}" Style="{StaticResource Subheading}"/><TextBlock Text="{Binding Explanation}"/><TextBlock Text="{Binding PossibleCause}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/><TextBlock Text="{Binding RecommendedAction}" Margin="0,8,0,0"/>
      </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
     <StackPanel>
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="Settings"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource Settings}" Style="{StaticResource Heading}" Margin="0,0,0,24"/>
      <Border Style="{StaticResource ShaghadCard}"><StackPanel>
       <TextBlock x:Name="CoreEngineValue" Text="{Binding CoreDisplay}" Style="{StaticResource TechnicalText}"/><TextBlock x:Name="TechnicalEndpoint" Text="{Binding Endpoint}" Style="{StaticResource TechnicalText}"/><ComboBox ItemsSource="{Binding Cores}" SelectedItem="{Binding SelectedCore}" IsEnabled="{Binding CanEdit}"/><TextBlock Text="{DynamicResource AppearanceTitle}" Style="{StaticResource Subheading}"/>
       <TextBlock Text="{DynamicResource Theme}" Style="{StaticResource LocalizedText}"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="Theme" AutomationProperties.AutomationId="ThemeSelector"/>
       <TextBlock Text="{DynamicResource Language}" Style="{StaticResource LocalizedText}"/><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" AutomationProperties.Name="Language" AutomationProperties.AutomationId="LanguageSelector"/>
       <Button Content="{DynamicResource Save}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Style="{StaticResource ShaghadPrimaryButton}" AutomationProperties.AutomationId="SavePreferences"/>
       <TextBlock Text="{DynamicResource CloseNotice}" Style="{StaticResource SecondaryText}" Margin="0,20,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource ShaghadCard}"><DockPanel><Image Source="{DynamicResource ShaghadSymbol}" Width="56" Height="56" FlowDirection="LeftToRight" Margin="0,0,18,0"/><StackPanel><TextBlock Text="SHAGHAD | شغاد" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ProductDescription}" Style="{StaticResource SecondaryText}"/><Button Content="{DynamicResource About}" Command="{Binding NavigateCommand}" CommandParameter="About" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></DockPanel></Border>
      <Border Style="{StaticResource ShaghadCard}"><StackPanel><TextBlock Text="{DynamicResource SystemProxyTitle}" Style="{StaticResource Subheading}"/><TextBlock Text="{DynamicResource SystemProxyNotice}" Style="{StaticResource SecondaryText}"/><WrapPanel Margin="0,14,0,0"><Button Content="{DynamicResource ApplyProxy}" Command="{Binding ApplyProxyCommand}"/><Button Content="{DynamicResource RestoreProxy}" Command="{Binding RestoreProxyCommand}"/></WrapPanel></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AboutPage">
      <StackPanel.Style><Style TargetType="StackPanel" BasedOn="{StaticResource Page}"><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="About"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{DynamicResource About}" Style="{StaticResource Heading}"/>
      <Border Style="{StaticResource ShaghadCard}"><StackPanel>
       <DockPanel Margin="0,0,0,12" FlowDirection="LeftToRight">
        <Image Source="{DynamicResource ShaghadSymbol}" Width="56" Height="56" Margin="0,0,16,0"/>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="SHAGHAD | شغاد" FontSize="24" FontWeight="SemiBold" FlowDirection="LeftToRight"/><TextBlock Text="{DynamicResource ProductDescription}" Style="{StaticResource SecondaryText}"/></StackPanel>
       </DockPanel>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0"><TextBlock Text="{DynamicResource ApplicationVersion}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock x:Name="ApplicationVersionValue" Text="{Binding ApplicationVersion}" Style="{StaticResource TechnicalText}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource CoreVersion}" Style="{StaticResource SecondaryText}" FontSize="12"/><TextBlock x:Name="CoreVersionValue" Text="{Binding CoreSummary}" Style="{StaticResource TechnicalText}" Margin="0,4,0,0"/></StackPanel>
       </Grid>
       <TextBlock Text="{DynamicResource GitHubRepository}" Style="{StaticResource SecondaryText}" FontSize="12"/>
       <TextBlock Style="{StaticResource TechnicalText}" Margin="0,4,0,10"><Hyperlink NavigateUri="{Binding GitHubRepository, Mode=OneWay}" RequestNavigate="OpenRepository" Foreground="{DynamicResource SymbolBrush}"><Run Text="{Binding GitHubRepository, Mode=OneWay}"/></Hyperlink></TextBlock>
       <WrapPanel Margin="0,0,0,10"><Button Content="{DynamicResource CheckCores}" Command="{Binding RefreshCoresCommand}" AutomationProperties.AutomationId="VerifyCores"/><Button Content="{DynamicResource OpenLicenses}" Click="OpenLicenses" AutomationProperties.AutomationId="OpenLicenses"/></WrapPanel>
       <TextBlock x:Name="AttributionText" Text="{DynamicResource Attribution}" Style="{StaticResource SecondaryText}" FontSize="12"/>
      </StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </DockPanel>
 </Grid>
</Window>


